# Copy this file to db.properties (same folder) and fill in your own values.
# db.properties is git-ignored. NEVER commit real passwords.
# Environment variables DB_URL, DB_USER and DB_PASSWORD override these values (used by CI).
db.url=jdbc:mysql://localhost:3306/healthdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
db.user=root
db.password=change_me
